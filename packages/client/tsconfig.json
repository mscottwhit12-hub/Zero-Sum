{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["svelte"],
    "verbatimModuleSyntax": true,
    "paths": { "@copy/*": ["../../copy/*"], "@shared/*": ["./src/shared/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
